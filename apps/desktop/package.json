{
  "name": "@mobi/desktop",
  "type": "module",
  "version": "2.1.6",
  "private": true,
  "description": "墨笔桌面版：Electron 外壳，复用 apps/web 的渲染进程",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:shell": "vite build --mode main && vite build --mode preload",
    "package": "pnpm run build && electron-builder --publish never",
    "package:mac": "pnpm run build && electron-builder --mac --publish never",
    "package:win": "pnpm run build && electron-builder --win --publish never",
    "package:linux": "pnpm run build && electron-builder --linux --publish never",
    "start": "electron .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@mobi/config": "workspace:*",
    "@mobi/shared": "workspace:*",
    "@types/node": "^25.5.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.0.3"
  }
}
