{
  "name": "@md/desktop",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "墨笔桌面版：Electron 外壳，复用 apps/web 的渲染进程",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:shell": "vite build --mode main && vite build --mode preload",
    "start": "electron .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@md/config": "workspace:*",
    "@md/shared": "workspace:*",
    "@types/node": "^25.5.0",
    "electron": "^43.4.0",
    "vite": "^8.0.3"
  }
}
