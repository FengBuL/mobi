{
  "name": "md",
  "type": "module",
  "version": "2.1.1",
  "private": true,
  "description": "Local Markdown editor web app",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "pnpm web dev",
    "build:web": "pnpm --filter @md/web build",
    "build:desktop": "pnpm --filter @md/desktop build",
    "desktop": "pnpm --filter @md/desktop dev",
    "proxy": "pnpm --filter @md/mp-proxy start",
    "web": "pnpm --filter @md/web",
    "type-check": "pnpm --filter @md/web type-check && pnpm --filter @md/desktop type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.40.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
